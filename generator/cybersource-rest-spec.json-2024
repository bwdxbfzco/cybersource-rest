                                            "type": {
                                                "type": "string",
                                                "readOnly": true,
                                                "description": "The type of error.\n\nPossible Values:\n  - invalidHeaders\n  - missingHeaders\n  - invalidFields\n  - missingFields\n  - unsupportedPaymentMethodModification\n  - invalidCombination\n"
                                            },
