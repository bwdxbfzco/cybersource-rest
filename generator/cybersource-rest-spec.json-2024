                                    "example": "merchantId"
                                },
                                "userName": {
                                    "type": "string",
                                    "description": "User ID of the user you want to get details on.",
                                    "example": "userName"
                                },
                                "roleId": {
                                    "type": "string",
                                    "description": "role of the user you are trying to search on.",
                                    "example": "custom"
