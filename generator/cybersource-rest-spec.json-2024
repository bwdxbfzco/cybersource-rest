                },
                "summary": "Update a Webhook Subscription",
                "description": "Update the webhook subscription using PATCH.",
                "operationId": "updateWebhookSubscription",
                "parameters": [
                    {
                        "name": "webhookId",
                        "in": "path",
                        "type": "string",
                        "description": "The Webhook Identifier.",
                        "required": true
                    },
                    {
                        "name": "updateWebhookRequest",
                        "in": "body",
                        "description": "The webhook payload or changes to apply.",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "Client friendly webhook name."
                                },
                                "description": {
                                    "type": "string",
                                    "description": "Client friendly webhook description.\\"
                                },
                                "organizationId": {
                                    "type": "string",
                                    "description": "Organization Id."
                                },
                                "productId": {
                                    "type": "string",
                                    "description": "The product you are receiving a webhook for."
