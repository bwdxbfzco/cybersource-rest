                                                    "type": "string",
                                                    "maxLength": 60
                                                },
                                                "lastName": {
                                                    "description": "Customer's last name.\n",
                                                    "type": "string",
                                                    "maxLength": 60
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
