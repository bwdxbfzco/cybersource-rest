                                },
                                "status": {
                                    "type": "string",
                                    "description": "The status of the submitted transaction.\n\nPossible values:\n - ACCEPTED\n"
                                },
                                "clientReferenceInformation": {
                                    "type": "object",
                                    "properties": {
                                        "code": {
                                            "type": "string",
                                            "maxLength": 50,
