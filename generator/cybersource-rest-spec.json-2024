                        "type": "string"
                    },
                    {
                        "name": "organizationIds",
                        "in": "query",
                        "description": "List of Orgaization Ids to search. The maximum size of the organization Ids list is 1. The maximum length of Organization Id is 30.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "keyIds",
                        "in": "query",
