                                "type": "string"
                            },
                            "uniqueTransactionID": {
                                "description": "A globally unique Id associated with your request.",
                                "type": "string"
                            }
                        },
                        "schema": {
                            "type": "object",
                            "readOnly": true,
                            "properties": {
