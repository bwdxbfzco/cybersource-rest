                    "developerGuides": "https://developer.cybersource.com/docs/cybs/en-us/tms/developer/ctv/rest/tms/tms-ship-tkn/tms-ship-addr-tkn-retrieve-all-intro.html"
                },
                "produces": [
                    "application/json;charset=utf-8"
                ],
                "x-depends": {
                    "example": {
