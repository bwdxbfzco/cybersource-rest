                                            "lastName": "Doe"
                                        }
                                    }
                                ]
                            },
                            "paymentInformation": {
                                "card": {
                                    "type": "002",
                                    "expirationMonth": "12",
                                    "expirationYear": "2025",
                                    "number": "5200000000000007"
