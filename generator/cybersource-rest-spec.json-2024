                                                "description": "Localized Key Name"
                                            }
                                        },
                                        "description": "Provide validation failed input field details"
                                    }
                                }
                            },
                            "description": "Error Bean"
                        }
                    }
                },
                "x-example": {
                    "example0": {
                        "summary": "Create Report Subscription",
                        "value": {
                            "reportDefinitionName": "TransactionRequestClass",
                            "reportFields": [
                                "Request.RequestID",
                                "Request.TransactionDate",
                                "Request.MerchantID",
                                "AFSFields.IPAddress",
                                "AFSFields.IPCountry",
                                "AFSFields.IPRoutingMethod",
                                "AFSFields.IPState",
                                "Application.Name",
                                "BankInfo.Address",
                                "BankInfo.BranchCode",
                                "BankInfo.City",
                                "BankInfo.Country",
                                "BankInfo.Name",
