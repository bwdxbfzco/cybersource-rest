                    "example65": {
                        "summary": "PIN-less Debit Purchase Using EMV Technology with Contactless Less Than or Equal to $50",
                        "sample-name": "PIN-less Debit Purchase Using EMV Technology with Contactless Less Than or Equal to $50",
                        "value": {
