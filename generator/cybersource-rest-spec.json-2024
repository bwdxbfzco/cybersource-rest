                                                                                        "segmentId"
                                                                                    ]
                                                                                },
                                                                                "amex": {
                                                                                    "type": "object",
                                                                                    "properties": {
                                                                                        "mode": {
                                                                                            "type": "string",
                                                                                            "description": "Type of mode. Valid values are `tokenApi` or `dailyHarvest`."
                                                                                        },
                                                                                        "seNumber": {
                                                                                            "type": "string"
                                                                                        },
                                                                                        "subscriberId": {
                                                                                            "type": "string"
                                                                                        },
                                                                                        "active": {
                                                                                            "type": "boolean"
                                                                                        }
                                                                                    }
                                                                                },
                                                                                "preferredDay": {
                                                                                    "type": "number",
                                                                                    "minimum": 1,
                                                                                    "maximum": 28
                                                                                },
                                                                                "daysWindow": {
                                                                                    "type": "number",
                                                                                    "minimum": 1,
                                                                                    "maximum": 3650,
                                                                                    "default": 31
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        },
