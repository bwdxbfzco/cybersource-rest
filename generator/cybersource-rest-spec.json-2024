                                "firstName": "John",
                                "lastName": "Doe",
                                "company": "CyberSource",
                                "address1": "1 Market St",
                                "locality": "San Francisco",
                                "administrativeArea": "CA",
                                "postalCode": "94105",
                                "country": "US",
                                "email": "test@cybs.com",
                                "phoneNumber": "4158880000"
                            }
                        }
                    },
                    "example1": {
                        "summary": "Make Customer Shipping Address the default",
                        "value": {
                            "default": "true"
                        }
                    }
