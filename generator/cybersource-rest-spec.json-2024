                                    "readOnly": true,
                                    "items": {
                                        "type": "object",
                                        "readOnly": true,
                                        "properties": {
                                            "type": {
                                                "type": "string",
                                                "readOnly": true,
                                                "description": "The type of error.\n\nPossible Values:\n  - conflict\n"
                                            },
                                            "message": {
                                                "type": "string",
                                                "readOnly": true,
                                                "description": "The detailed message related to the type."
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "examples": {
