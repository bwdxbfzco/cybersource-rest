                                                                                                            "type": "string",
                                                                                                            "maxLength": 15,
                                                                                                            "description": "TBD"
                                                                                                        },
                                                                                                        "originatorTerminalId": {
                                                                                                            "type": "array",
                                                                                                            "description": "TBD",
                                                                                                            "items": {
                                                                                                                "type": "string",
                                                                                                                "maxLength": 8
                                                                                                            }
                                                                                                        },
                                                                                                        "supportedCurrencies": {
                                                                                                            "type": "array",
                                                                                                            "description": "Three-character [ISO Standard Currency Codes.](http://apps.cybersource.com/library/documentation/sbc/quickref/currencies.pdf)",
                                                                                                            "items": {
                                                                                                                "type": "string",
                                                                                                                "maxLength": 3,
                                                                                                                "minLength": 3
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                },
                                                                                                "description": "TBD"
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
