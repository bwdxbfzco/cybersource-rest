                                                    "type": "string",
                                                    "readOnly": true,
                                                    "maxLength": 4,
                                                    "description": "Four-digit year in which the customer's latest payment card expires.\n\nFormat: `YYYY`.\n"
                                                }
                                            }
                                        }
                                    }
                                },
